# PostgreSQL connection string. Percent-encode reserved characters in credentials.
DATABASE_URL="postgresql://USER:PERCENT_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"

# PIN required to open Reports in the dashboard (default 1234 if unset)
REPORTS_PIN="1234"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Deployed Digital Menu URL
NEXT_PUBLIC_DIGITAL_MENU_URL="https://mondocoffee-digitalmenu.vercel.app"
